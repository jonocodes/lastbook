<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>org.lastbook.Lastbook</id>
  <name>Lastbook</name>
  <summary>Offline survival library</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <url type="homepage">https://lastbook.org</url>
  <url type="vcs-browser">https://github.com/Immortal-Protocols/lastbook</url>
  <developer id="org.lastbook">
    <name>Lastbook</name>
  </developer>
  <description>
    <p>Lastbook searches and reads a survival library kept on this computer: guides, manuals, videos, maps and an encyclopedia, with no internet. It opens no network port. Setup downloads the library the first time; nothing else goes online unless you ask it to check for a newer version.</p>
  </description>
  <launchable type="desktop-id">org.lastbook.Lastbook.desktop</launchable>
